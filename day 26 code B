#include <stdio.h>

int main()
{
    int i, j;

    for(i = 1; i <= 5; i++)
    {
        if(i % 2 != 0)   // Odd rows: print 1, 3, 5 stars
        {
            for(j = 1; j <= i; j++)
            {
                printf("*\n");
            }
        }
        else             // Even rows: print a blank line
        {
            printf("\n");
        }
    }

    return 0;
}
