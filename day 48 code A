#include <stdio.h>

int main()
{
    char s1[100], s2[100], temp[200];
    int i, j, len1 = 0, len2 = 0, flag = 0;

    scanf("%s %s", s1, s2);

    while(s1[len1] != '\0')
        len1++;

    while(s2[len2] != '\0')
        len2++;

    if(len1 != len2)
    {
        printf("Not Rotation");
        return 0;
    }

    for(i = 0; i < len1; i++)
        temp[i] = s1[i];

    for(i = 0; i < len1; i++)
        temp[len1 + i] = s1[i];

    temp[2 * len1] = '\0';

    for(i = 0; i <= len1; i++)
    {
        for(j = 0; j < len2; j++)
        {
            if(temp[i + j] != s2[j])
                break;
        }

        if(j == len2)
        {
            flag = 1;
            break;
        }
    }

    if(flag == 1)
        printf("Rotation");
    else
        printf("Not Rotation");

    return 0;
}
