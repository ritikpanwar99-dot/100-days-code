#include <stdio.h>

int main()
{
    char str[100];
    int i, j, flag = 0;

    scanf("%s", str);

    for(i = 0; str[i] != '\0'; i++)
    {
        if(str[i] >= 'a' && str[i] <= 'z')
        {
            for(j = i + 1; str[j] != '\0'; j++)
            {
                if(str[i] == str[j])
                {
                    printf("%c", str[i]);
                    flag = 1;
                    break;
                }
            }
        }

        if(flag == 1)
            break;
    }

    if(flag == 0)
        printf("No repeating character");

    return 0;
}
