#include <stdio.h>

int main()
{
    int num, original, sum = 0, rem;

    printf("Enter a number: ");
    scanf("%d", &num);

    if (num < 0)
    {
        printf("Negative numbers are not allowed.\n");
    }
    else
    {
        original = num;

        while (num > 0)
        {
            rem = num % 10;
            sum = sum + rem;
            num = num / 10;
        }

        printf("Sum of digits of %d = %d\n", original, sum);
    }

    return 0;
}
