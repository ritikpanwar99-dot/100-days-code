#include <stdio.h>
#include <math.h>

int main()
{
    int num, first, last, digits, middle, result, power;

    printf("Enter a number: ");
    scanf("%d", &num);

    last = num % 10;

    digits = (int)log10(num);

    power = (int)pow(10, digits);

    first = num / power;

    middle = (num % power) / 10;

    result = last * power + middle * 10 + first;

    printf("Number after swapping first and last digit = %d\n", result);

    return 0;
}
