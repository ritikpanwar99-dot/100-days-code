#include <stdio.h>

int main()
{
    int n, a[100], i, value, pos = -1;

    scanf("%d", &n);

    for(i = 0; i < n; i++)
    {
        scanf("%d", &a[i]);
    }

    scanf("%d", &value);

    for(i = 0; i < n; i++)
    {
        if(a[i] == value)
        {
            pos = i;
            break;
        }
    }

    if(pos == -1)
    {
        printf("Element not found");
    }
    else
    {
        for(i = pos; i < n - 1; i++)
        {
            a[i] = a[i + 1];
        }

        n--;

        for(i = 0; i < n; i++)
        {
            printf("%d ", a[i]);
        }
    }

    return 0;
}
