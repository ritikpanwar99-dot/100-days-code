#include <stdio.h>

int main()
{
    char str[100];
    int i = 0, j, last = 0;

    fgets(str, sizeof(str), stdin);

    while(str[i] != '\0')
    {
        if(str[i] == ' ')
        {
            last = i + 1;
        }
        i++;
    }

    for(i = 0; i < last - 1; i++)
    {
        if(i == 0 || str[i - 1] == ' ')
        {
            printf("%c. ", str[i]);
        }
    }

    for(j = last; str[j] != '\0' && str[j] != '\n'; j++)
    {
        printf("%c", str[j]);
    }

    return 0;
}
