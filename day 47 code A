#include <stdio.h>

int main()
{
    char s1[100], s2[100];
    int f1[26] = {0}, f2[26] = {0};
    int i, flag = 1;

    scanf("%s %s", s1, s2);

    for(i = 0; s1[i] != '\0'; i++)
    {
        f1[s1[i] - 'a']++;
    }

    for(i = 0; s2[i] != '\0'; i++)
    {
        f2[s2[i] - 'a']++;
    }

    for(i = 0; i < 26; i++)
    {
        if(f1[i] != f2[i])
        {
            flag = 0;
            break;
        }
    }

    if(flag == 1)
        printf("Anagram");
    else
        printf("Not Anagram");

    return 0;
}
