#include <stdio.h>

int main()
{
    int n;
    float sum = 0.0;

    printf("Enter the number of terms: ");
    scanf("%d", &n);

    if (n <= 0)
    {
        printf("Invalid input! Please enter a positive number.\n");
        return 0;
    }

    for (int i = 1; i <= n; i++)
    {
        if (i == 1)
        {
            sum += 1.0;
        }
        else
        {
            sum += (float)(2 * i - 1) / (2 * i - 2);
        }
    }

    printf("Sum of the series = %.2f\n", sum);

    return 0;
}
